generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  DEALER
  INTERNAL_ADMIN
}

// Cordon's internal exclusivity check: is another dealer already working this
// farm? Not shown to dealers — this is separate from the client-facing
// pipeline stage below. Every lead starts PENDING; nothing auto-clears, a
// Cordon admin always makes the call.
enum RegistrationState {
  PENDING // awaiting a Cordon admin decision
  CLEARED // admin approved — dealer holds exclusivity
  REJECTED // lost to another dealer's claim on the same farm
  EXPIRED // exclusivity window lapsed with no resolution
}

// The client-engagement pipeline. A flat dropdown, not an enforced state
// machine — any stage can be selected at any time (same as the spreadsheet
// this replaced), but the values now read as an actual sales pipeline.
enum LeadStage {
  CLIENT_EXPRESSED_INTEREST
  CLIENT_QUALIFIED
  LOOP_ROI_DISCUSSED
  READY_FOR_QUOTE // surfaced as an admin alert — see /admin/overview
  CLIENT_WANTS_DEMO
  CLIENT_WANTS_TO_DISCUSS_WITH_CORDON
  CLOSED_WON
  CLOSED_NOT_YET
  CLOSED_LOST
}

enum QuoteStatus {
  PRE_QUOTE // too early to say — not every first conversation gets to a quote
  NEEDS_QUOTE
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  INVOICED
}

// Used by productOptionsStatus below — same "who owes this, is it done"
// checklist the spreadsheet uses. DEALER_* is shown as the actual dealer's
// name in the UI (the sheet hardcodes "Vinescapes", model stays dealer-agnostic).
enum TaskStatus {
  DEALER_TODO
  DEALER_DONE
  CORDON_TODO
  CORDON_DONE
}

model Dealer {
  id        String   @id @default(cuid())
  name      String
  region    String?
  tier      String? // e.g. "Standard" / "Preferred" / "Premier" — plain string until real tier list is known
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  users  User[]
  leads  Lead[]
  orders Order[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(DEALER)
  createdAt    DateTime @default(now())

  // null for internal Cordon staff (INTERNAL_ADMIN); set for dealer accounts
  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  // Set by an admin to force this user's existing sessions to be treated as
  // invalid — checked on every request via the JWT callback.
  sessionInvalidatedAt DateTime?

  approvedLeads Lead[]        @relation("ApprovedBy")
  activityLogs  ActivityLog[]
  notes         Note[]

  @@index([dealerId])
}

model Lead {
  id        String @id @default(cuid())
  legalName String // legal name of the customer's business
  farm      String
  phone     String?
  email     String?

  // When this lead was registered — separate from createdAt (the DB row's
  // creation time), since a dealer may be recording a registration that
  // predates when it was entered into the system.
  registrationDate DateTime @default(now())

  // Who at the dealer surfaced this lead. Simple text, auto-filled from the
  // submitting user's name at creation — not a separate role or permission.
  leadGeneratorName String?

  // Every lead requires a Cordon admin decision — nothing auto-clears.
  registrationState RegistrationState @default(PENDING)
  stage             LeadStage         @default(CLIENT_EXPRESSED_INTEREST)
  closedLostReason  String? // shown/relevant when stage = CLOSED_LOST

  quoteStatus   QuoteStatus @default(PRE_QUOTE)
  quotedAt      DateTime?
  quoteValueGbp Float?

  // Simple flag rather than a to-do/done tracker — either it needs discussing
  // with the client or it doesn't.
  roiToBeDiscussed Boolean?

  // Whether the loop sprayer product specification has been agreed with the
  // client, plus the actual agreed spec once it has.
  productOptionsStatus TaskStatus?
  solidHoppers         Int? // 0-2
  liquidLines          Int? // 1-4
  flowBoost            Boolean?

  // Sales-process context, free text since the shape of these varies a lot
  // by customer.
  buyingProcess String? // e.g. "committee vote", "single owner decision"
  finalApprover String? // who has the final say on the purchase

  // Stubbed for phase 2 (commission tracking) — not surfaced in the UI yet.
  commission Float?

  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // Set on a REJECTED lead when it lost a same-farm conflict to another
  // dealer's registration, pointing at the lead that was approved instead.
  resolvedByLeadId String?
  resolvedByLead    Lead?  @relation("ConflictResolution", fields: [resolvedByLeadId], references: [id])
  resolvedAgainst   Lead[] @relation("ConflictResolution")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  orders       Order[]
  notes        Note[]
  activityLogs ActivityLog[]

  @@index([dealerId])
  @@index([registrationState])
}

model Order {
  id       String @id @default(cuid())
  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  // Parallel arrays per spec (items[i] <-> quantities[i]). No product catalog exists yet,
  // so this stays loose JSON rather than a normalized OrderItem table.
  items      Json
  quantities Json

  status    String   @default("PENDING") // no fixed value set given yet — plain string
  createdAt DateTime @default(now())

  @@index([dealerId])
  @@index([leadId])
}

model Note {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Denormalized alongside leadId so dealer-scoped queries never need to join through Lead.
  dealerId String

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id])

  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([dealerId])
}

// Placeholder for Cordon's internal sales pipeline (HubSpot long-term) until
// that's connected. A matching row here means Cordon is already working this
// farm directly. Currently populated manually — no HubSpot sync yet.
model InternalPipelineEntry {
  id        String   @id @default(cuid())
  farm      String
  createdAt DateTime @default(now())

  @@index([farm])
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([leadId])
}
