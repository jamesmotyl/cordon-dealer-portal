# Postgres connection strings (Vercel Postgres / Supabase / Neon all work).
# DIRECT_URL is used for migrations when your pooled URL doesn't support them
# (e.g. Supabase pgbouncer, Neon pooled connections). If your provider only
# gives you one URL, set DIRECT_URL to the same value.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Set to your deployed URL in production, e.g. https://dealer-portal.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Resend (email alerts to admins on new lead submission). Get a key at
# resend.com — new-lead emails are silently skipped if this isn't set.
RESEND_API_KEY=""
# Must be a verified sender in Resend (their own domain or your verified one).
# Defaults to Resend's shared test address if unset.
EMAIL_FROM="Cordon Dealer Portal <onboarding@resend.dev>"
